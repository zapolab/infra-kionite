{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dockerfile": {
    "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"
      ]
  },
  "pinDigests": true,
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile",
        "github-actions"
      ],
      "matchUpdateTypes": [
        "pinDigest",
        "digest",
        "patch",
        "minor",
        "major"
      ],
      "automerge": true
    }
  ]
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dockerfile": {
    "managerFilePatterns": [
        "/(^|/|\\.)([Dd]ocker|[Cc]ontainer)file$/",
        "/(^|/)([Dd]ocker|[Cc]ontainer)file[^/]*$/"
      ]
  },
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false,
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "pinDigests": true,
      "matchUpdateTypes": [
        "pinDigest",
        "digest"
      ],
      "automerge": true
    }
  ]
}
